      <description>&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;margin-bottom: 12px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align: middle; padding-right: 12px;&quot;&gt;&lt;img src=&quot;https://avatars.githubusercontent.com/u/5596239?s=96&amp;amp;v=4&quot; width=&quot;96&quot; height=&quot;96&quot; alt=&quot;@dschrempf&quot; style=&quot;margin: 0; padding: 0; border-radius: 50%;&quot; /&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align: middle;&quot;&gt;&lt;strong&gt;&lt;a href=&quot;https://github.com/dschrempf&quot;&gt;Dominik Schrempf&lt;/a&gt;&lt;/strong&gt;&lt;br&gt;&lt;span style=&quot;color: #57606a;&quot;&gt;@dschrempf&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;I like Haskell.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;69&lt;/strong&gt; followers · &lt;strong&gt;8&lt;/strong&gt; following&lt;/p&gt;&lt;ul style=&quot;list-style-type: none; padding-left: 0;&quot;&gt;&lt;li style=&quot;list-style-type: none; margin-bottom: 4px;&quot;&gt;&lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/building.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;building&quot; style=&quot;margin: 0 8px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;Well-Typed LLP&lt;/li&gt;&lt;li style=&quot;list-style-type: none; margin-bottom: 4px;&quot;&gt;&lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/map-pin.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;map-pin&quot; style=&quot;margin: 0 8px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;Austria&lt;/li&gt;&lt;li style=&quot;list-style-type: none; margin-bottom: 4px;&quot;&gt;&lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/link.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;link&quot; style=&quot;margin: 0 8px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;&lt;a href=