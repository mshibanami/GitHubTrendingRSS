e rendered by Handlebars&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/sytone/system-bootstrap&quot;&gt;&lt;strong&gt;system-bootstrap&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;5 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;0&lt;br&gt;scripts used to bootstrap and setup my systems&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/sytone/obsidian-mstodo-sync&quot;&gt;&lt;strong&gt;obsidian-mstodo-sync&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;28 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;16&lt;br&gt;microsoft-todo for obsidian.md&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/sytone/botnexus&quot;&gt;&lt;strong&gt;botnexus&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;2 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&