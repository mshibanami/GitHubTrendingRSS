ne-block; vertical-align: middle;&quot; /&gt;247&lt;br&gt;Command Line Tool for interacting with MachO binaries on OSX/iOS&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/alexzielenski/ThemeEngine&quot;&gt;&lt;strong&gt;ThemeEngine&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;770 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;136&lt;br&gt;OS X App to edit compiled .car files&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/alexzielenski/ZKRevealingTableViewCell&quot;&gt;&lt;strong&gt;ZKRevealingTableViewCell&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;341 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;52&lt;br&gt;A Sparrow-style Implementation of Swipe-To-Reveal&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/alexzielenski/StartAtLoginController&quot;&gt;&lt;strong&gt;StartAtLoginController&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;210 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;24&lt;br&gt;A class that uses the new ServiceManagement api to allow apps to run at login.&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/alexzielenski/ZKSwizzle&quot;&gt;&lt;strong&gt;ZKSwizzle&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;158 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;29&lt;br&gt;Streamlined way to swizzle Objective-C instance and class methods&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/alexzielenski/Opee&quot;&gt;&lt;strong&gt;Opee&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;108 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;7&lt;br&gt;Code Injection Platform for OS X&lt;/li&gt;&lt;/ul&gt;&lt;hr&gt;&lt;h1&gt;ZKInspector&lt;/h1&gt; 
&lt;p&gt;An NSOutlineView subclass for 10.9+ that gets you a collapsable stack of views like Xcode&#39;s inspector.&lt;/p&gt; 
&lt;p&gt;&lt;img src=&quot;https://github.com/alexzielenski/ZKInspector/raw/master/preview.png&quot; alt=&quot;Preview&quot; title=&quot;Preview&quot; /&gt;&lt;/p&gt; 
&lt;h1&gt;Usage&lt;/h1&gt; 
&lt;p&gt;Create an &lt;code&gt;NSOutlineView&lt;/code&gt; as you normally would in interface builder then simply change its class to &lt;code&gt;ZKInspector&lt;/code&gt;&lt;/p&gt; 
&lt;pre&gt;&lt;code class=&quot;language-objc&quot;&gt;- (void)applicationDidFinishLaunching:(NSNotification *)aNotification {
    self.inspector.inspectorDelegate = self;
    // Insert code here to initialize your application
    [self.inspector addView:[[NSView alloc] initWithFrame:NSMakeRect(0, 0, 0, 1)] withTitle:@&quot;View 1&quot; expanded:NO];
    [self.inspector addView:self.view2 withTitle:@&quot;View 2&quot; expanded:NO];

    
    [self.inspector setTitle:@&quot;New Title&quot; forIndex:0];    
}

- (void)applicationWillTerminate:(NSNotification *)aNotification {
    // Insert code here to tear down your application
}

- (BOOL)inspector:(ZKInspector *)inspector shouldExpandView:(NSView *)view withTitle:(NSString *)title atIndex:(NSUInteger)index {
    return index != 0;
}

- (void)inspector:(ZKInspector *)inspector didExpandView:(NSView *)view withTitle:(NSString *)title atIndex:(NSUInteger)index {
    if (index == 1 &amp;amp;&amp;amp; inspector.numberOfViews == 2) {
        static BOOL dispatched = NO;
        if (!dispatched) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                [self.inspector addView:self.view3 withTitle:@&quot;View 3&quot; expanded:YES];
                [self.inspector setView:self.view1 forIndex:1];
            });
            dispatched = YES;
        }
    } else if (index == 2) {
        [self.inspector setTitle:[[NSUUID UUID] UUIDString] forIndex:1];
        [self.inspector moveViewAtIndex:0 toIndex:1];
    }
}

- (CGFloat)inspector:(ZKInspector *)inspector heightForView:(NSView *)view withTitle:(NSString *)title atIndex:(NSUInteger)index {
    return 132.0;
}


