anami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;169 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;28&lt;br&gt;Neovim plugin for code review annotations in codediff.nvim. Add comments to diffs, export as AI-ready markdown. Inspired by tuicr.&lt;/p&gt;&lt;h4&gt;Other Repositories (Pinned)&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/arcana&quot;&gt;&lt;strong&gt;arcana&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;345 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;11&lt;br&gt;Embeddable RAG library for Elixir/Phoenix with agentic pipelines and dashboard&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/elixir-agent-tools&quot;&gt;&lt;strong&gt;elixir-agent-tools&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;192 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;14&lt;br&gt;Elixir development skills with optional Mix checks and Expert language server integration&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/awesome-ml-gen-ai-elixir&quot;&gt;&lt;strong&gt;awesome-ml-gen-ai-elixir&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;296 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;12&lt;br&gt;A curated list of Machine Learning libraries and resources for the Elixir programming language. &lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/soothsayer&quot;&gt;&lt;strong&gt;soothsayer&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;142 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;2&lt;br&gt;Elixir library for time series forecasting, inspired by Facebook&amp;#39;s Prophet and NeuralProphet&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/alike&quot;&gt;&lt;strong&gt;alike&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;46 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;0&lt;br&gt;Semantic similarity testing for Elixir. Test LLM outputs, chatbots, and NLP in Elixir&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;https://github.com/elixir-nx/hnswlib&quot;&gt;&lt;strong&gt;hnswlib&lt;/strong&gt;&lt;/a&gt; &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/star.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;star&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;71 &lt;img src=&quot;https://mshibanami.github.io/GitHubTrendingRSS/assets/icons/git-fork.png&quot; width=&quot;20&quot; height=&quot;20&quot; alt=&quot;git-fork&quot; style=&quot;margin: 0 4px 0 0; padding: 0; display: inline-block; vertical-align: middle;&quot; /&gt;12&lt;br&gt;Elixir binding for the hnswlib library.&lt;/li&gt;&lt;/ul&gt;&lt;hr&gt;&lt;h2&gt;George Guimarães&lt;/h2&gt; 
&lt;p&gt;Hands-on tech leader and repeat founder with 20+ years turning code into products. Co-founded &lt;a href=&quot;https://plataformatec.com&quot;&gt;Plataformatec&lt;/a&gt; (acquired by Nubank), the company behind the &lt;a href=&quot;https://elixir-lang.org&quot;&gt;Elixir programming language&lt;/a&gt;. Currently building infrastructure for agentic commerce at &lt;a href=&quot;https://new-gen.ai&quot;&gt;New Generation&lt;/a&gt;.&lt;/p&gt; 
&lt;p&gt;&lt;a href=&quot;https://linkedin.com/in/georgeguimaraes&quot;&gt;&lt;img src=&quot;https://img.shields.io/badge/LinkedIn-0077B5?style=flat&amp;amp;logo=linkedin&amp;amp;logoColor=white&quot; alt=&quot;LinkedIn&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;https://x.com/georgeguimaraes&quot;&gt;&lt;img src=&quot;https://img.shields.io/badge/X-000000?style=flat&amp;amp;logo=x&amp;amp;logoColor=white&quot; alt=&quot;X&quot; /&gt;&lt;/a&gt;&lt;/p&gt; 
&lt;h3&gt;Blog Posts&lt;/h3&gt; 
&lt;!-- BLOG-POST-LIST:START --&gt; 
&lt;ul&gt; 
 &lt;li&gt;&lt;a href=&quot;https://georgeguimaraes.com/stop-putting-mimic-copy-in-test_helper-exs/&quot;&gt;Stop Putting Mimic.copy in test_helper.exs&lt;/a&gt;&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://georgeguimaraes.com/review-nvim-code-review-annotations-ai/&quot;&gt;review.nvim: Code Review Annotations for AI Feedback Loops&lt;/a&gt;&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://georgeguimaraes.com/smelter-json-schema-elixir-code-generator/&quot;&gt;Smelter: JSON Schema to Elixir Code Generator&lt;/a&gt;&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://georgeguimaraes.com/best-practices-expire/&quot;&gt;Best Practices Expire&lt;/a&gt;&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://georgeguimaraes.com/leidenfold-leiden-community-detection-elixir/&quot;&gt;Leidenfold: Leiden Community Detection for Elixir&lt;/a&gt;&lt;/li&gt; 
&lt;/ul&gt; 
&lt;!-- BLOG-POST-LIST:END --&gt; 
&lt;h3&gt;Open Source&lt;/h3&gt; 
&lt;p&gt;AI and ML for Elixir:&lt;/p&gt; 
&lt;ul&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/transmuter&quot;&gt;transmuter&lt;/a&gt; - Runs Hugging Face ONNX models on any Nx backend, with no per-architecture code&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/arcana&quot;&gt;arcana&lt;/a&gt; - Embeddable RAG library for Elixir/Phoenix with agentic pipelines and a dashboard&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/tribunal&quot;&gt;tribunal&lt;/a&gt; - LLM evaluation framework: ExUnit assertions, dataset runs and CI gates&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/alike&quot;&gt;alike&lt;/a&gt; - Semantic similarity testing for LLM outputs with the &lt;code&gt;&amp;lt;~&amp;gt;&lt;/code&gt; operator&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/hallmark&quot;&gt;hallmark&lt;/a&gt; - Hallucination detection with Vectara&#39;s HHEM model, running locally on Bumblebee&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/stephen&quot;&gt;stephen&lt;/a&gt; - ColBERT-style neural retrieval&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/soothsayer&quot;&gt;soothsayer&lt;/a&gt; - Time series forecasting, inspired by Prophet and NeuralProphet&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/leidenfold&quot;&gt;leidenfold&lt;/a&gt; - Leiden community detection bindings&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/elixir-nx/hnswlib&quot;&gt;hnswlib&lt;/a&gt; - Approximate nearest neighbour search, in the elixir-nx org&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/bazaar&quot;&gt;bazaar&lt;/a&gt; - SDK for serving AI agent commerce protocols (UCP and ACP) from one Phoenix handler&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/awesome-ml-gen-ai-elixir&quot;&gt;awesome-ml-gen-ai-elixir&lt;/a&gt; - Curated list of ML and GenAI libraries and resources for Elixir&lt;/li&gt; 
&lt;/ul&gt; 
&lt;p&gt;Elixir libraries and tools:&lt;/p&gt; 
&lt;ul&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/otera&quot;&gt;otera&lt;/a&gt; - Jinja templates in pure Elixir, with Hugging Face chat templates rendered byte for byte like Python&lt;/li&gt; 
 &lt;li&gt;&lt;a href=&quot;https://github.com/georgeguimaraes/dayoff&quot;&gt;dayoff&lt;/a&gt; - Public holidays for 200+ countries, states and regions, offline, synced daily from date-holidays&lt;/li&gt; 
